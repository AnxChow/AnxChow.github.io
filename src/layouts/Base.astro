---
import '../styles/global.css';
import NavLinks from '../components/NavLinks.astro';

interface Props {
  title: string;
  active?: 'home' | 'career' | 'books';
}

const { title, active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Karla:ital,wght@0,400;0,500;0,700;1,400&family=Fredoka:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-55WW86L68L"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-55WW86L68L');
    </script>
  </head>
  <body>
    <nav aria-label="main">
      <NavLinks variant="bar" active={active} />
    </nav>

    <slot />

    <footer>
      <span class="hand">ankita chowdhry</span>
      <span class="footer-icons">
        <a href="mailto:ankitachowdhry97@gmail.com" aria-label="email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5.5" width="18" height="13" rx="2" />
            <path d="m4 7 8 6 8-6" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/ankita-chowdhry/" aria-label="linkedin">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3.5" y="3.5" width="17" height="17" rx="2.5" />
            <path d="M8 10.5V17M8 7.4v.1M12 17v-3.8c0-1.5 4-1.7 4 0V17" />
          </svg>
        </a>
        <a href="https://github.com/AnxChow" aria-label="github">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15.5 20.5v-2.8c0-.8-.2-1.4-.7-1.8 2.3-.3 4.7-1.1 4.7-5a3.9 3.9 0 0 0-1-2.7 3.6 3.6 0 0 0-.1-2.7s-.9-.3-2.9 1a9.8 9.8 0 0 0-5 0c-2-1.3-2.9-1-2.9-1a3.6 3.6 0 0 0-.1 2.7 3.9 3.9 0 0 0-1 2.7c0 3.9 2.4 4.7 4.7 5-.4.4-.7 1-.7 1.8v2.8" />
            <path d="M8.5 18.5c-2 .8-3.5-.5-4-1.5" />
          </svg>
        </a>
      </span>
    </footer>
  </body>
</html>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    gap: 1.4rem;
    padding: 0.55rem 0;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1000px;
    margin: 4rem auto 0;
    padding: 1.2rem 1.5rem 1.6rem;
    border-top: 1px solid var(--line);
  }

  .footer-icons {
    display: flex;
    gap: 0.8rem;
  }

  .footer-icons a {
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .footer-icons a:hover {
    color: var(--ink);
  }

  .footer-icons svg {
    width: 18px;
    height: 18px;
  }
</style>

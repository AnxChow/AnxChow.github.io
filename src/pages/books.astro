---
import Base from '../layouts/Base.astro';

// ---- the shelf ----
// a selection of 4- and 5-star reads (pulled from goodreads).
// add a book by dropping an object in here. spine/h/w control the look;
// leave `take` blank and the modal shows a "coming soon" placeholder so
// you know where your review goes.
type Book = {
  title: string;
  subtitle?: string;
  author: string;
  spine: string;   // spine color (a pastel var or hex)
  text?: string;   // spine text color
  h: number;       // spine height in px (varies for a real-shelf look)
  w: number;       // spine width in px
  added: string;   // when it hit the shelf
  take?: string;   // your review
  quote?: string;  // a favorite line (optional)
};

const books: Book[] = [
  { title: 'Careless People', subtitle: 'A Cautionary Tale of Power, Greed, and Lost Idealism',
    author: 'Sarah Wynn-Williams', spine: 'var(--blush)', h: 300, w: 48, added: 'May 2026', take: '' },
  { title: 'The Spy and the Traitor', subtitle: 'The Greatest Espionage Story of the Cold War',
    author: 'Ben Macintyre', spine: 'var(--butter)', h: 335, w: 54, added: 'Jun 2025',
    take: 'incredible non-fiction that reads like a spy thriller — gripping at every single turn. i kept forgetting it actually happened.' },
  { title: 'The Jakarta Method', subtitle: "Washington's Anticommunist Crusade and the Mass Murder Program that Shaped Our World",
    author: 'Vincent Bevins', spine: 'var(--sage)', h: 315, w: 50, added: 'Jul 2023', take: '' },
  { title: 'All Good People Here', author: 'Ashley Flowers',
    spine: 'var(--blue)', h: 305, w: 46, added: 'Dec 2022', take: '' },
  { title: 'Recursion', author: 'Blake Crouch',
    spine: 'var(--lavender)', h: 290, w: 44, added: 'Aug 2022', take: '' },
  { title: 'Before the Coffee Gets Cold', author: 'Toshikazu Kawaguchi',
    spine: 'var(--blush)', h: 285, w: 44, added: 'Aug 2022', take: '' },
  { title: 'Project Hail Mary', author: 'Andy Weir',
    spine: 'var(--butter)', h: 322, w: 50, added: 'Jan 2022', take: '' },
  { title: 'Dark Matter', author: 'Blake Crouch',
    spine: 'var(--sage)', h: 288, w: 44, added: 'Jan 2022',
    take: 'completely hooked. sci-fi grounded in real science — the kind of book you accidentally finish in two sittings.' },
  { title: 'The Seven Husbands of Evelyn Hugo', author: 'Taylor Jenkins Reid',
    spine: 'var(--blue)', h: 328, w: 52, added: 'Dec 2021', take: '' },
  { title: 'Red Line', subtitle: "The Unraveling of Syria and America's Race to Destroy the Most Dangerous Arsenal in the World",
    author: 'Joby Warrick', spine: 'var(--lavender)', h: 300, w: 48, added: 'Apr 2021', take: '' },
  { title: 'The Midnight Library', author: 'Matt Haig',
    spine: 'var(--blush)', h: 296, w: 46, added: 'Dec 2020',
    take: 'made me stop and pause — a whole book about the lives you could have lived, and what a “best life” even means. matt haig is a gift.' },
  { title: 'No Filter', subtitle: 'The Inside Story of Instagram', author: 'Sarah Frier',
    spine: 'var(--butter)', h: 310, w: 46, added: 'Dec 2020', take: '' },
];
---

<Base title="ankita chowdhry — books" active="books">
  <main>
    <header>
      <h1>the bookshelf</h1>
      <p class="sub">a selection of my 4- and 5-star reads over the years.</p>
      <p class="hand">pull one off the shelf →</p>
    </header>

    <section class="shelf" aria-label="bookshelf">
      <div class="shelf-inner">
        <div class="books">
          {books.map((b, i) => (
            <button
              class="spine"
              style={`--spine: ${b.spine}; --text: ${b.text ?? 'var(--ink)'}; --h: ${b.h}px; --w: ${b.w}px`}
              data-i={i}
              data-title={b.title}
              data-subtitle={b.subtitle ?? ''}
              data-author={b.author}
              data-added={b.added}
              data-take={b.take ?? ''}
              data-quote={b.quote ?? ''}
              data-spine={b.spine}
            >
              <span class="spine-title">{b.title}</span>
              <span class="spine-author">{b.author}</span>
            </button>
          ))}
        </div>
        <div class="ledge"></div>
      </div>
    </section>

    <!-- the pulled-out book -->
    <dialog class="book-modal" id="book-modal">
      <div class="modal-inner">
        <button class="close" id="modal-close" aria-label="close">×</button>
        <div class="cover" id="modal-cover">
          <span class="cover-title" id="modal-cover-title"></span>
          <span class="cover-author" id="modal-cover-author"></span>
        </div>
        <div class="details">
          <p class="read" id="modal-added"></p>
          <h2 id="modal-title"></h2>
          <p class="subtitle" id="modal-subtitle"></p>
          <p class="by" id="modal-author"></p>
          <p class="take" id="modal-take"></p>
          <blockquote id="modal-quote"></blockquote>
        </div>
      </div>
    </dialog>
  </main>
</Base>

<script>
  const modal = document.getElementById('book-modal') as HTMLDialogElement;
  const cover = document.getElementById('modal-cover')!;
  const $ = (id: string) => document.getElementById(id)!;

  document.querySelectorAll<HTMLButtonElement>('.spine').forEach((spine) => {
    spine.addEventListener('click', () => {
      // "pull it off the shelf", then open
      spine.classList.add('pulling');
      setTimeout(() => {
        const d = spine.dataset;
        cover.style.setProperty('--spine', d.spine!);
        $('modal-cover-title').textContent = d.title!;
        $('modal-cover-author').textContent = d.author!;
        $('modal-title').textContent = d.title!;
        $('modal-author').textContent = `by ${d.author}`;
        $('modal-added').textContent = `added ${d.added}`;

        const sub = $('modal-subtitle');
        sub.textContent = d.subtitle || '';
        sub.style.display = d.subtitle ? 'block' : 'none';

        const take = $('modal-take');
        if (d.take) {
          take.textContent = d.take;
          take.classList.remove('empty');
        } else {
          take.textContent = 'my notes on this one — coming soon.';
          take.classList.add('empty');
        }

        const q = $('modal-quote');
        q.textContent = d.quote ? `“${d.quote}”` : '';
        q.style.display = d.quote ? 'block' : 'none';

        modal.showModal();
        spine.classList.remove('pulling');
      }, 200);
    });
  });

  const close = () => modal.close();
  document.getElementById('modal-close')!.addEventListener('click', close);
  // click on the backdrop (outside the inner panel) closes
  modal.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
</script>

<style>
  main {
    max-width: 940px;
    margin: 0 auto;
    padding: 4rem 1.5rem 1rem;
  }

  header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0 0 0.4rem;
  }

  .sub {
    margin: 0 0 0.3rem;
    color: color-mix(in srgb, var(--ink) 80%, var(--muted));
  }

  /* ---- the shelf ---- */
  .shelf {
    margin-top: 2rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .shelf-inner {
    width: max-content;
    margin: 0 auto;
  }

  .books {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    min-height: 345px;
    padding: 0 0.4rem;
  }

  /* a single spine */
  .spine {
    position: relative;
    width: var(--w);
    height: var(--h);
    border: none;
    border-radius: 2px 3px 0 0;
    background:
      linear-gradient(90deg, rgba(255,255,255,0.35) 0 3px, transparent 3px),
      linear-gradient(270deg, rgba(0,0,0,0.14) 0 5px, transparent 5px),
      var(--spine);
    color: var(--text);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    box-shadow: inset 0 -3px 0 rgba(0,0,0,0.08);
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease;
  }

  .spine-title {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--serif);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    max-height: calc(var(--h) - 66px);
    text-overflow: ellipsis;
  }

  .spine-author {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--accent);
    font-size: 0.68rem;
    opacity: 0.72;
    white-space: nowrap;
    overflow: hidden;
    max-height: 90px;
    text-overflow: ellipsis;
  }

  /* pop up a little on hover */
  .spine:hover {
    transform: translateY(-16px);
    box-shadow: 0 12px 20px rgba(60, 50, 30, 0.18), inset 0 -3px 0 rgba(0,0,0,0.08);
  }

  /* the quick "pull off the shelf" motion before the modal opens */
  .spine.pulling {
    transform: translateY(-30px) scale(1.04);
    z-index: 5;
  }

  .ledge {
    height: 16px;
    border-radius: 3px;
    background: linear-gradient(180deg, #e7dcc7, #c9ba9c);
    box-shadow: 0 10px 22px rgba(60, 50, 30, 0.18);
  }

  /* ---- the pulled-out book (modal) ---- */
  .book-modal {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 640px;
    width: calc(100% - 2rem);
  }

  .book-modal::backdrop {
    background: rgba(30, 26, 20, 0.45);
    backdrop-filter: blur(3px);
  }

  .book-modal[open] .modal-inner {
    animation: rise 0.35s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px) scale(0.96); }
    to { opacity: 1; transform: none; }
  }

  .modal-inner {
    position: relative;
    display: flex;
    gap: 1.6rem;
    padding: 1.8rem;
    background: var(--paper);
    border-radius: 6px 16px 16px 16px;
    box-shadow: 0 20px 50px rgba(30, 26, 20, 0.35);
  }

  .close {
    position: absolute;
    top: 0.6rem;
    right: 0.9rem;
    border: none;
    background: none;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
  }
  .close:hover { color: var(--ink); }

  /* the little cover standing up */
  .cover {
    flex-shrink: 0;
    width: 130px;
    height: 195px;
    padding: 1rem 0.8rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 3px 8px 8px 3px;
    background: linear-gradient(105deg, color-mix(in srgb, var(--spine) 78%, #fff), var(--spine));
    box-shadow: inset 7px 0 0 -4px rgba(0,0,0,0.18), 3px 4px 10px rgba(60,50,30,0.2);
  }

  .cover-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.2;
  }
  .cover-author {
    font-family: var(--accent);
    font-size: 0.78rem;
    opacity: 0.75;
  }

  .details { min-width: 0; }

  .read {
    font-family: var(--accent);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.2rem;
  }

  .details h2 { font-size: 1.5rem; margin: 0; line-height: 1.15; }
  .subtitle { font-family: var(--serif); font-style: italic; color: var(--muted); margin: 0.3rem 0 0; }
  .by { color: var(--muted); margin: 0.3rem 0 0.5rem; }

  .take { margin: 0.7rem 0 0; }
  .take.empty { color: var(--muted); font-style: italic; }

  blockquote {
    margin: 1rem 0 0;
    padding-left: 0.9rem;
    border-left: 3px solid var(--line);
    font-family: var(--serif);
    font-style: italic;
    color: color-mix(in srgb, var(--ink) 75%, var(--muted));
  }

  @media (max-width: 620px) {
    .modal-inner { flex-direction: column; align-items: center; text-align: center; }
    .details { text-align: left; }
  }
</style>

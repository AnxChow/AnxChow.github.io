---
import Base from '../layouts/Base.astro';

// each stop sits on the winding path — x is % across, y is px down
const stops = [
  {
    place: 'singapore', years: 'the beginning', color: 'var(--butter)',
    x: 44, y: 90, side: 'left',
    story: 'grew up here before heading to the US for college.',
  },
  {
    place: 'northwestern', years: '2015 – 2019', color: 'var(--lavender)',
    x: 56, y: 370, side: 'right',
    story: 'bs in computer science, farley entrepreneurship certificate. ta’d human-computer interaction and intro to programming, and was president of the bhangra team.',
  },
  {
    place: 'meta', years: '2019 – 2020', color: 'var(--blue)',
    x: 44, y: 650, side: 'left',
    story: 'product technical program manager on the ads core ml team — ran ads resource management across 40+ teams (compute, storage, memory) and shaped capacity planning. came on full-time after two internships (swe on feed ads quality, tpm on ads ranking).',
  },
  {
    place: 'applied intuition', years: '2020 – 2022', color: 'var(--sage)',
    x: 56, y: 930, side: 'right',
    story: 'applied’s first tpm. scaled the release cycle as the team doubled, and incubated + launched a hardware-in-the-loop validation product.',
  },
  {
    place: 'streamlabs', years: '2022 – 2023', color: 'var(--blush)',
    x: 44, y: 1210, side: 'left',
    story: 'product manager across creator-economy products. enhanced the payments platform and relaunched the custom site builder, lifting custom-site adoption.',
  },
  {
    place: 'harvard business school', years: '2023 – 2025', color: 'var(--butter)',
    x: 56, y: 1490, side: 'right',
    story: 'mba. co-led the inaugural entrepreneurship summit (30+ speakers, 300+ attendees), interned in vc and an ai venture studio.',
  },
  {
    place: 'payabli', years: '2025 – now', color: 'var(--lavender)', current: true,
    x: 44, y: 1770, side: 'left',
    story: 'lead ai pm. founded payabli’s ai function. shipped amigo, payabli’s ai agent suite.',
  },
];

const H = 1890;
// smooth winding path through the dots, bulging to the edges between them
const path = [
  'M44,90',
  'C 92,200 92,260 56,370',
  'C 8,480 8,540 44,650',
  'C 92,760 92,820 56,930',
  'C 8,1040 8,1100 44,1210',
  'C 92,1320 92,1380 56,1490',
  'C 8,1600 8,1660 44,1770',
].join(' ');
---

<Base title="ankita chowdhry — career" active="career">
  <main>
    <header>
      <h1>the path so far</h1>
      <p class="sub">explored the full gamut of tech, from big to small company, b2b to consumer. but endlessly fascinated by ai/ml — how something as simple as pattern-matching, done fast enough, can feel like magic.</p>
      <a class="toggle" href="/career">play it as snake 🐍 →</a>
    </header>

    <!-- the winding trail (desktop) -->
    <div class="trail" style={`--h: ${H}px`}>
      <svg class="trail-line" viewBox={`0 0 100 ${H}`} preserveAspectRatio="none" aria-hidden="true">
        <path d={path} fill="none" stroke="var(--line)" stroke-width="2.5"
          stroke-dasharray="2 6" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      </svg>

      {stops.map((stop) => (
        <div
          class:list={['stop', stop.side, { current: stop.current }]}
          style={`top: ${stop.y}px`}
        >
          <div class="card">
            <span class="years">{stop.years}</span>
            <h2>{stop.place}</h2>
            <p>{stop.story}</p>
            {stop.current && <span class="here hand">★ you are here</span>}
          </div>
        </div>
      ))}

      <!-- dots sit on the trail, positioned against the whole container -->
      {stops.map((stop) => (
        <span
          class:list={['dot', { current: stop.current }]}
          style={`top: ${stop.y}px; left: ${stop.x}%; --dot: ${stop.color}`}
        ></span>
      ))}
    </div>

    <!-- simple stacked version (mobile) -->
    <ol class="trail-mobile">
      {stops.map((stop) => (
        <li class:list={{ current: stop.current }} style={`--dot: ${stop.color}`}>
          <span class="dot"></span>
          <span class="years">{stop.years}</span>
          <h2>{stop.place}</h2>
          <p>{stop.story}</p>
          {stop.current && <span class="here hand">★ you are here</span>}
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 4rem 1.5rem 1rem;
  }

  header {
    text-align: center;
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0 0 0.6rem;
  }

  .sub {
    max-width: 640px;
    margin: 0 auto 0.4rem;
    color: color-mix(in srgb, var(--ink) 80%, var(--muted));
  }

  .toggle {
    display: inline-block;
    margin-top: 0.9rem;
    padding: 0.4rem 1rem;
    font-family: var(--accent);
    font-size: 0.92rem;
    color: var(--ink);
    background: var(--blush);
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 2px 0 rgba(60, 50, 30, 0.12);
    transition: transform 0.15s ease;
  }

  .toggle:hover { transform: translateY(-2px); }

  /* ---- winding trail ---- */
  .trail {
    position: relative;
    height: var(--h);
  }

  .trail-line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stop {
    position: absolute;
    width: 40%;
    transform: translateY(-50%);
  }

  .stop.left {
    left: 0;
    text-align: right;
  }

  .stop.right {
    right: 0;
    text-align: left;
  }

  /* dot sits on the trail, positioned against the whole container */
  .dot {
    position: absolute;
    width: 15px;
    height: 15px;
    margin: -7.5px 0 0 -7.5px;
    border-radius: 50%;
    background: var(--dot);
    border: 2px solid var(--ink);
    z-index: 2;
  }

  .card {
    position: relative;
    display: inline-block;
    max-width: 340px;
    padding: 1rem 1.2rem;
    background: #fff;
    border-radius: 4px 14px 14px 14px;
    box-shadow: 0 3px 14px rgba(60, 50, 30, 0.1);
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-align: left;
  }

  .card:hover {
    transform: translateY(-4px) rotate(-1deg);
  }

  .years {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-transform: uppercase;
  }

  h2 {
    font-size: 1.4rem;
    margin: 0.15rem 0 0.5rem;
  }

  .stop p,
  .trail-mobile p {
    margin: 0;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }

  .here {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--ink);
  }

  .dot.current,
  .trail-mobile .current .dot {
    animation: pulse 2.2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--dot) 75%, transparent); }
    50% { box-shadow: 0 0 0 9px transparent; }
  }

  /* ---- mobile stacked ---- */
  .trail-mobile {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .trail-mobile::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 7px;
    border-left: 2px dashed var(--line);
  }

  .trail-mobile li {
    position: relative;
    padding: 0 0 2.4rem 2.2rem;
  }

  .trail-mobile .dot {
    position: absolute;
    top: 6px;
    left: 0.5px;
    margin: 0;
  }

  @media (max-width: 720px) {
    .trail {
      display: none;
    }

    .trail-mobile {
      display: block;
    }
  }
</style>

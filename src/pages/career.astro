---
import Base from '../layouts/Base.astro';

const stops = [
  { place: 'singapore', years: 'the beginning', color: 'var(--butter)',
    story: 'grew up here before heading to the US for college.' },
  { place: 'northwestern', years: '2015 – 2019', color: 'var(--lavender)',
    story: 'bs in computer science, farley entrepreneurship certificate. ta’d human-computer interaction and intro to programming, and was president of the bhangra team.' },
  { place: 'meta', years: '2019 – 2020', color: 'var(--blue)',
    story: 'product technical program manager on the ads core ml team — ran ads resource management across 40+ teams (compute, storage, memory) and shaped capacity planning. came on full-time after two internships (swe on feed ads quality, tpm on ads ranking).' },
  { place: 'applied intuition', years: '2020 – 2022', color: 'var(--sage)',
    story: 'applied’s first tpm. scaled the release cycle as the team doubled, and incubated + launched a hardware-in-the-loop validation product.' },
  { place: 'streamlabs', years: '2022 – 2023', color: 'var(--blush)',
    story: 'product manager across creator-economy products. enhanced the payments platform and relaunched the custom site builder, lifting custom-site adoption.' },
  { place: 'harvard business school', years: '2023 – 2025', color: 'var(--butter)',
    story: 'mba. co-led the inaugural entrepreneurship summit (30+ speakers, 300+ attendees), interned in vc and an ai venture studio.' },
  { place: 'payabli', years: '2025 – now', color: 'var(--lavender)', current: true,
    story: 'lead ai pm. founded payabli’s ai function. shipped amigo, payabli’s ai agent suite.' },
];
---

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" />

<Base title="ankita chowdhry — career" active="career">
  <main>
    <header>
      <h1>the path so far</h1>
      <p class="sub">explored the full gamut of tech, from big to small company, b2b to consumer. but endlessly fascinated by ai/ml — how something as simple as pattern-matching, done fast enough, can feel like magic.</p>
      <p class="hand">eat the dots to collect each step — don't bite yourself.</p>
      <a class="toggle" href="/career-timeline">see the timeline view →</a>
    </header>

    <div class="game">
      <!-- the arcade screen -->
      <div class="console">
        <div class="screen">
          <canvas id="board" width="440" height="308"></canvas>

          <div class="overlay" id="ov-start">
            <p class="pix big">PRESS START</p>
            <p class="pix small key">↑ ↓ ← → &nbsp;/&nbsp; tap a pad</p>
          </div>
          <div class="overlay hidden" id="ov-over">
            <p class="pix big">GAME OVER</p>
            <p class="pix small" id="over-msg"></p>
            <button class="pix btn" id="btn-again">SLITHER ON</button>
          </div>
          <div class="overlay hidden" id="ov-win">
            <p class="pix big win">YOU MADE IT ★</p>
            <p class="pix small">7 / 7 collected — that's the whole path.</p>
            <button class="pix btn" id="btn-replay">PLAY AGAIN</button>
          </div>
        </div>

        <div class="hud">
          <span class="pix score">COLLECTED <b id="score">0</b>/7</span>
          <div class="dpad" aria-label="controls">
            <button class="pad up" data-dir="0,-1" aria-label="up">▲</button>
            <button class="pad left" data-dir="-1,0" aria-label="left">◀</button>
            <button class="pad right" data-dir="1,0" aria-label="right">▶</button>
            <button class="pad down" data-dir="0,1" aria-label="down">▼</button>
          </div>
        </div>
      </div>

      <!-- the collectible slots -->
      <ol class="slots" id="slots">
        {stops.map((stop) => (
          <li class="slot" style={`--c: ${stop.color}`}>
            <div class="locked-face" aria-hidden="true"><span class="pix">?</span></div>
            <div class="content">
              <span class="years">{stop.years}</span>
              <h2>{stop.place}</h2>
              <p>{stop.story}</p>
              {stop.current && <span class="here hand">★ you are here</span>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </main>
</Base>

<script>
  const cols = 20, rows = 14, CELL = 22;
  const canvas = document.getElementById('board') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  canvas.width = cols * CELL;
  canvas.height = rows * CELL;

  const scoreEl = document.getElementById('score')!;
  const slots = Array.from(document.querySelectorAll('.slot'));
  const ovStart = document.getElementById('ov-start')!;
  const ovOver = document.getElementById('ov-over')!;
  const ovWin = document.getElementById('ov-win')!;
  const overMsg = document.getElementById('over-msg')!;

  const GREEN = '#4dff88', GLOW = '#39ff14', FOOD = '#ffc23d', BG = '#0e140e';

  let snake: {x:number;y:number}[], dir: {x:number;y:number}, nextDir: {x:number;y:number};
  let food: {x:number;y:number} | null, revealed = 0, started = false, dead = false, won = false;
  let timer: number | undefined;

  // progressive enhancement: only lock the slots once JS is running
  slots.forEach((s) => s.classList.add('locked'));

  function resetSnake() {
    snake = [{x:6,y:7},{x:5,y:7},{x:4,y:7}];
    dir = {x:1,y:0}; nextDir = {x:1,y:0};
    started = false; dead = false;
    placeFood();
    clearTimeout(timer);
    draw();
  }

  function placeFood() {
    if (revealed >= 7) { food = null; return; }
    let p: {x:number;y:number};
    do {
      p = { x: (Math.random()*cols)|0, y: (Math.random()*rows)|0 };
    } while (snake.some((s) => s.x === p.x && s.y === p.y));
    food = p;
  }

  function start() {
    if (started || dead || won) return;
    started = true;
    ovStart.classList.add('hidden');
    tick();
  }

  function tick() {
    dir = nextDir;
    const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

    const hitWall = head.x < 0 || head.x >= cols || head.y < 0 || head.y >= rows;
    const hitSelf = snake.some((s) => s.x === head.x && s.y === head.y);
    if (hitWall || hitSelf) return die();

    snake.unshift(head);

    if (food && head.x === food.x && head.y === food.y) {
      reveal(revealed);
      revealed++;
      scoreEl.textContent = String(revealed);
      if (revealed >= 7) return win();
      placeFood();
    } else {
      snake.pop();
    }

    draw();
    const speed = Math.max(95, 145 - revealed * 7);
    timer = window.setTimeout(tick, speed);
  }

  function reveal(i: number) {
    const slot = slots[i];
    slot.classList.remove('locked');
    slot.classList.add('pop');
    slot.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function die() {
    dead = true;
    clearTimeout(timer);
    overMsg.textContent = `${revealed}/7 collected. keep going?`;
    ovOver.classList.remove('hidden');
  }

  function win() {
    won = true;
    clearTimeout(timer);
    draw();
    ovWin.classList.remove('hidden');
  }

  function draw() {
    if (!snake) return;
    ctx.fillStyle = BG;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // faint grid
    ctx.fillStyle = 'rgba(120,180,130,0.06)';
    for (let x = 0; x < cols; x++)
      for (let y = 0; y < rows; y++)
        ctx.fillRect(x*CELL + CELL/2 - 1, y*CELL + CELL/2 - 1, 2, 2);

    // food (pulsing)
    if (food) {
      const p = 2 + Math.sin(Date.now()/180) * 1.5;
      ctx.shadowColor = FOOD; ctx.shadowBlur = 12;
      ctx.fillStyle = FOOD;
      ctx.fillRect(food.x*CELL + p, food.y*CELL + p, CELL - p*2, CELL - p*2);
      ctx.shadowBlur = 0;
    }

    // snake
    ctx.shadowColor = GLOW; ctx.shadowBlur = 10;
    snake.forEach((s, i) => {
      ctx.fillStyle = i === 0 ? '#b6ffcf' : GREEN;
      ctx.fillRect(s.x*CELL + 1, s.y*CELL + 1, CELL - 2, CELL - 2);
    });
    ctx.shadowBlur = 0;

    // eyes on the head
    const h = snake[0];
    ctx.fillStyle = BG;
    const ex = 6 + dir.x * 4, ey = 6 + dir.y * 4;
    ctx.fillRect(h.x*CELL + ex, h.y*CELL + ey, 3, 3);
    ctx.fillRect(h.x*CELL + CELL - ex - 3, h.y*CELL + ey, 3, 3);
  }

  function setDir(x: number, y: number) {
    if (dead || won) return;
    if (x === -dir.x && y === -dir.y) return; // no instant reverse
    nextDir = { x, y };
    start();
  }

  const KEYS: Record<string, [number, number]> = {
    ArrowUp:[0,-1], ArrowDown:[0,1], ArrowLeft:[-1,0], ArrowRight:[1,0],
    w:[0,-1], s:[0,1], a:[-1,0], d:[1,0],
  };
  window.addEventListener('keydown', (e) => {
    const k = KEYS[e.key];
    if (!k) return;
    e.preventDefault();
    setDir(k[0], k[1]);
  });

  document.querySelectorAll('.pad').forEach((b) =>
    b.addEventListener('click', () => {
      const [x, y] = (b as HTMLElement).dataset.dir!.split(',').map(Number);
      setDir(x, y);
    }));

  // swipe on the screen
  let sx = 0, sy = 0;
  canvas.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, {passive:true});
  canvas.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) < 20 && Math.abs(dy) < 20) return;
    if (Math.abs(dx) > Math.abs(dy)) setDir(Math.sign(dx), 0);
    else setDir(0, Math.sign(dy));
  }, {passive:true});

  document.getElementById('btn-again')!.addEventListener('click', () => {
    ovOver.classList.add('hidden');
    resetSnake();
    ovStart.classList.remove('hidden');
  });
  document.getElementById('btn-replay')!.addEventListener('click', () => {
    won = false; revealed = 0; scoreEl.textContent = '0';
    slots.forEach((s) => { s.classList.add('locked'); s.classList.remove('pop'); });
    ovWin.classList.add('hidden');
    resetSnake();
    ovStart.classList.remove('hidden');
  });

  resetSnake();
  // keep the food pulsing before the game starts
  (function idle() { if (!started && !won) draw(); requestAnimationFrame(idle); })();
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 4rem 1.5rem 1rem;
  }

  header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0 0 0.6rem;
  }

  .sub {
    max-width: 640px;
    margin: 0 auto 0.4rem;
    color: color-mix(in srgb, var(--ink) 80%, var(--muted));
  }

  .toggle {
    display: inline-block;
    margin-top: 0.9rem;
    padding: 0.4rem 1rem;
    font-family: var(--accent);
    font-size: 0.92rem;
    color: var(--ink);
    background: var(--blue);
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 2px 0 rgba(60, 50, 30, 0.12);
    transition: transform 0.15s ease;
  }

  .toggle:hover { transform: translateY(-2px); }

  .game {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2.5rem;
    align-items: start;
  }

  /* ---- arcade console ---- */
  .console {
    position: sticky;
    top: 80px;
  }

  .screen {
    position: relative;
    padding: 14px;
    background: linear-gradient(160deg, var(--sage), var(--blue));
    border-radius: 18px;
    box-shadow: 0 4px 0 rgba(60,50,30,0.15), 0 14px 30px rgba(60,50,30,0.16),
      inset 0 0 0 3px rgba(255,255,255,0.4);
  }

  canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    image-rendering: pixelated;
    background: #0e140e;
    box-shadow: inset 0 0 22px rgba(0,0,0,0.7);
  }

  /* CRT scanlines over the screen */
  .screen::after {
    content: '';
    position: absolute;
    inset: 14px;
    border-radius: 8px;
    pointer-events: none;
    background: repeating-linear-gradient(rgba(0,0,0,0.14) 0 1px, transparent 1px 3px);
  }

  .overlay {
    position: absolute;
    inset: 14px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    background: rgba(6,12,6,0.78);
    z-index: 2;
  }

  .overlay.hidden { display: none; }

  .pix {
    font-family: 'Press Start 2P', monospace;
    color: var(--butter);
    line-height: 1.6;
    margin: 0;
  }

  .pix.big { font-size: 1.1rem; color: #b6ffcf; text-shadow: 0 0 10px rgba(77,255,136,0.6); }
  .pix.win { color: #ffe08a; }
  .pix.small { font-size: 0.62rem; color: #dfeee0; }
  .pix.key { animation: blink 1.1s steps(1) infinite; }

  @keyframes blink { 50% { opacity: 0.25; } }

  .btn {
    font-size: 0.7rem;
    padding: 0.7rem 1rem;
    color: #0e140e;
    background: #4dff88;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 0 3px 0 #2bbf5e;
    transition: transform 0.1s ease;
  }
  .btn:active { transform: translateY(2px); box-shadow: 0 1px 0 #2bbf5e; }

  /* ---- hud + dpad ---- */
  .hud {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .score {
    font-size: 0.62rem;
    color: var(--muted);
  }
  .score b { color: var(--ink); }

  .dpad {
    display: grid;
    grid-template-columns: repeat(3, 34px);
    grid-template-rows: repeat(3, 34px);
    gap: 4px;
  }

  .pad {
    border: none;
    background: #fff;
    border-radius: 7px;
    font-size: 0.8rem;
    color: var(--ink);
    cursor: pointer;
    box-shadow: 0 2px 0 rgba(60,50,30,0.18);
    transition: transform 0.1s ease;
  }
  .pad:active { transform: translateY(2px); box-shadow: none; }
  .pad.up { grid-area: 1 / 2; }
  .pad.left { grid-area: 2 / 1; }
  .pad.right { grid-area: 2 / 3; }
  .pad.down { grid-area: 3 / 2; }

  /* ---- collectible slots ---- */
  .slots {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .slot {
    position: relative;
    padding: 0.9rem 1.1rem;
    background: var(--c);
    border-radius: 4px 12px 12px 12px;
    box-shadow: 0 2px 10px rgba(60,50,30,0.1);
    min-height: 46px;
  }

  .slot .years {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .slot h2 { font-size: 1.15rem; margin: 0.1rem 0 0.35rem; }
  .slot p { margin: 0; font-size: 0.9rem; color: color-mix(in srgb, var(--ink) 82%, var(--muted)); }
  .slot .here { display: inline-block; margin-top: 0.4rem; color: var(--ink); }

  /* locked state */
  .slot.locked { background: #efece4; }
  .slot.locked .content { display: none; }
  .locked-face { display: none; }
  .slot.locked .locked-face {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #c3bdae;
  }
  .locked-face .pix { font-family: 'Press Start 2P', monospace; font-size: 1rem; color: #c3bdae; }
  .slot.locked .locked-face::after {
    content: 'locked — keep eating';
    font-family: var(--accent);
    font-size: 0.9rem;
  }

  .slot.pop { animation: pop 0.4s cubic-bezier(0.34,1.56,0.64,1); }
  @keyframes pop {
    0% { transform: scale(0.9); opacity: 0.4; }
    100% { transform: scale(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pix.key, .slot.pop { animation: none; }
  }

  @media (max-width: 820px) {
    .game { grid-template-columns: 1fr; gap: 1.8rem; }
    .console { position: static; }
  }
</style>
